
@page "/processos"
@rendermode InteractiveServer

@using AppWebExemplo.Model
@using AppWebExemplo.DAO

@inject ProcessoDAO dao

<PageTitle>Processos - Sistema de Controle de Processos</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1">Consulta de Processos</h2>
        <p class="text-muted mb-0">
            Consulte os processos cadastrados no sistema.
        </p>
    </div>

    <div>
        <a href="/processos/cadastro" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i>
            Novo Processo
        </a>
    </div>
</div>

<div class="custom-table-card">
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Número</th>
                    <th>Interessado</th>
                    <th>Assunto</th>
                    <th>Situação</th>
                    <th class="text-end">Ações</th>
                </tr>
            </thead>

            <tbody>
                @if (processos.Count == 0)
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted">
                            Nenhum processo cadastrado.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var p in processos)
                    {
                        <tr>
                            <td>@p.Id</td>
                            <td>@p.Numero</td>
                            <td>@p.Interessado</td>
                            <td class="text-truncate">@p.Assunto</td>
                            <td>
                                <i class="bi bi-clock"></i>
                                @p.Situacao
                            </td>

                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    <a href="@($"/processos/editar/{p.Id}")"
                                       class="btn btn-light border text-primary"
                                       title="Editar"
                                       aria-label="@($"Editar processo {p.Numero}")">
                                        <i class="bi bi-pencil"></i>
                                    </a>

                                    <a href="@($"/processos/excluir/{p.Id}")"
                                       class="btn btn-light border text-danger"
                                       title="Excluir"
                                       aria-label="@($"Excluir processo {p.Numero}")">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@code {
    private List<Processo> processos = new();

    protected override void OnInitialized()
    {
        CarregarProcessos();
    }

    private void CarregarProcessos()
    {
        processos = dao.Listar();
    }
}
